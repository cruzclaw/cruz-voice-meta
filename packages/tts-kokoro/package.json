{
  "name": "@cruzclaw/tts-kokoro",
  "version": "0.2.1",
  "private": true,
  "description": "Local text-to-speech with Kokoro-82M. Isolated in its own package because its dependency tree carries unfixed image-library advisories that speech never reaches.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@cruzclaw/voice-core": "*",
    "kokoro-js": "1.2.1"
  }
}
