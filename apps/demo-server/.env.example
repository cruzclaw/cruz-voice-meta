# DEMO_TOKEN=
# PORT=8787
# VOICE_FEATURE_DISABLED=true
# TTS=tone   # skip Kokoro and play a test tone instead
# How the assistant addresses the person in its opening line. Optional.
# DEMO_USER_NAME=
